{
  "name": "olli-backend-service",
  "version": "0.1.0",
  "private": true,
  "description": "Maps a standard customer profile to a carrier's JSON quote form: eligibility, pre-fill and quote requests.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"console.log('No tests yet: Jest arrives in OLLI-INF-002')\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
